<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fathanstico - Petualangan Kapten Fathan</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Quicksand', sans-serif;
      background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%);
    }
    h1, h2, h3, .font-fun {
      font-family: 'Fredoka', cursive;
    }
    .card-fabulous {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 24px;
      box-shadow: 0 10px 25px -5px rgba(14, 165, 233, 0.15), 0 8px 10px -6px rgba(14, 165, 233, 0.1);
    }
  </style>
</head>
<body class="min-h-screen pb-12 text-slate-800">

  <!-- ========================================== -->
  <!-- KONFIGURASI GAS (LANGSUNG TERTANAM DI KODE) -->
  <!-- ========================================== -->
  <script>
    // MASUKKAN URL GOOGLE APPS SCRIPT (GAS) ANDA DI SINI
    // Contoh: const DEFAULT_GAS_URL = "https://script.google.com/macros/s/AKfycbyFLQ-TVFD1xllVXEjFlCJqVjjXvDUoA9H_0c9zysiEw7eZWQmf0SJt5LB6gr83hDJ8kA/exec";
    const DEFAULT_GAS_URL = "PASTE_WEB_APP_URL_GAS_ANDA_DI_SINI";
  </script>

  <!-- NAVBAR / HEADER UTAMA -->
  <header class="bg-sky-500 text-white px-6 py-4 shadow-lg rounded-b-3xl sticky top-0 z-50 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <div class="bg-yellow-400 p-2 rounded-2xl shadow-md text-2xl">🚀</div>
      <div>
        <h1 class="text-xl font-bold font-fun tracking-wide">Fathanstico</h1>
        <p class="text-xs text-sky-100">Akademi Penjelajah Keberanian</p>
      </div>
    </div>
    
    <!-- INDIKATOR BINTANG & XP -->
    <div class="flex items-center space-x-3">
      <div class="bg-sky-600/60 backdrop-blur px-3 py-1.5 rounded-full flex items-center space-x-1.5 border border-sky-300/30">
        <span class="text-lg">⭐</span>
        <span id="header-stars" class="font-bold text-sm">5/5</span>
      </div>
      <div class="bg-sky-600/60 backdrop-blur px-3 py-1.5 rounded-full flex items-center space-x-1.5 border border-sky-300/30">
        <span class="text-lg">⚡</span>
        <span id="header-xp" class="font-bold text-sm text-yellow-300">0 XP</span>
      </div>
      <button onclick="toggleOrtuModal()" class="bg-white/20 hover:bg-white/30 p-2 rounded-full transition text-xs font-semibold">
        🔒 Ortu
      </button>
    </div>
  </header>

  <main class="max-w-md mx-auto px-4 mt-6 space-x-0 space-y-6">

    <!-- BOKS PERISAI HARIAN -->
    <section class="card-fabulous p-5 border-2 border-amber-300/50 relative overflow-hidden">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center space-x-2">
          <span class="text-2xl">🛡️</span>
          <h2 class="text-lg font-bold font-fun text-amber-600">Perisai Keberanian Hari Ini</h2>
        </div>
        <button id="btn-activate-shield" onclick="activateShield()" class="bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold px-4 py-1.5 rounded-full text-xs shadow-md transition transform active:scale-95">
          ⚡ Aktifkan!
        </button>
      </div>

      <!-- KONTEN PERISAI TERSEMBUNYI -->
      <div id="shield-content" class="hidden mt-3 pt-3 border-t border-amber-100 bg-amber-50/50 p-3 rounded-xl">
        <p class="text-xs text-amber-800 font-semibold mb-1">Mantra Perisai Pelindung:</p>
        <p id="shield-mantra-text" class="text-sm font-bold text-amber-900 italic">"Kepal Tangan & Katakan 'Kapten Fathan Beraksi!'"</p>
        <p class="text-[11px] text-amber-700 mt-2 bg-amber-100/80 p-2 rounded-lg">
          💡 <strong>Kosa Kata Baru:</strong> <em>Perisai</em> adalah pelindung rasa takut. Rasa takut bukan arti kita lemah, tapi tanda bahwa keberanian kita sedang bertambah!
        </p>
      </div>
      <div id="shield-placeholder" class="text-xs text-slate-500 italic mt-1">
        Tekan "Aktifkan!" untuk membuka perisai keberanianmu hari ini...
      </div>
    </section>

    <!-- TAB RENCANA (MISI HARIAN & REWARD) -->
    <section class="card-fabulous p-5">
      <!-- TAB HEADER -->
      <div class="flex bg-slate-100 p-1 rounded-2xl mb-5">
        <button id="tab-btn-quests" onclick="switchTab('quests')" class="flex-1 py-2 rounded-xl text-xs font-bold transition bg-white text-sky-600 shadow-sm">
          🎯 Misi Harian
        </button>
        <button id="tab-btn-rewards" onclick="switchTab('rewards')" class="flex-1 py-2 rounded-xl text-xs font-bold transition text-slate-500">
          🎁 Toko Reward
        </button>
        <button id="tab-btn-story" onclick="switchTab('story')" class="flex-1 py-2 rounded-xl text-xs font-bold transition text-slate-500">
          📖 Cerita
        </button>
      </div>

      <!-- KONTEN TAB 1: MISI HARIAN -->
      <div id="tab-content-quests" class="space-y-4">
        <!-- MISI ATOMIK -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1. Kebiasaan Rutin Atomik</h3>
          <div id="container-atomic-quests" class="space-y-2"></div>
        </div>

        <!-- MISI KEBERANIAN -->
        <div class="pt-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-sky-500 mb-2">2. Misi Keberanian Ksatria</h3>
          <div id="container-courage-quests" class="space-y-2"></div>
        </div>
      </div>

      <!-- KONTEN TAB 2: TOKO REWARD (LOOT BOX) -->
      <div id="tab-content-rewards" class="hidden space-y-3">
        <p class="text-xs text-slate-500 mb-2">Tukarkan XP keberanianmu dengan voucher hadiah dari Ortu!</p>
        <div id="container-rewards-list" class="space-y-3"></div>
      </div>

      <!-- KONTEN TAB 3: CERITA BERSAMBUNG -->
      <div id="tab-content-story" class="hidden space-y-4">
        <div id="story-locked-notice" class="bg-amber-50 border border-amber-200 p-4 rounded-2xl text-center">
          <span class="text-3xl block mb-2">🔒</span>
          <h4 class="font-bold text-sm text-amber-800">Cerita Masih Terkunci</h4>
          <p class="text-xs text-amber-700 mt-1">Selesaikan misimu dan minta Ortu mengkonfirmasi Bintang untuk membuka episode hari ini!</p>
        </div>
        <div id="story-reader" class="hidden space-y-3">
          <h3 id="story-title" class="font-bold text-base text-sky-600 font-fun"></h3>
          <div id="story-text" class="text-xs text-slate-700 leading-relaxed space-y-2 bg-slate-50 p-4 rounded-2xl border border-slate-100"></div>
        </div>
      </div>
    </section>

    <!-- SECTION TIPS SCREEN TIME & SUGESI TRANSISI -->
    <section class="card-fabulous p-5 border-l-4 border-indigo-400">
      <div class="flex items-center space-x-2 mb-2">
        <span class="text-xl">📺</span>
        <h3 class="text-sm font-bold font-fun text-indigo-600">Tips Tayangan Baik dari Otto</h3>
      </div>
      <p id="otto-tip-text" class="text-xs text-slate-600 leading-relaxed italic">
        "Setelah menonton hal-hal seru, pastikan kita tetap mengucapkan kata-kata yang baik dan bersikap sopan ya!"
      </p>
    </section>

  </main>

  <!-- MODAL PARENT DASHBOARD -->
  <div id="modal-ortu" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 class="font-bold text-base font-fun text-slate-800">Dashboard Orang Tua</h3>
        <button onclick="toggleOrtuModal()" class="text-slate-400 hover:text-slate-600 text-lg">✕</button>
      </div>

      <!-- AUTH PIN -->
      <div id="ortu-auth-section" class="space-y-3">
        <p class="text-xs text-slate-500">Masukkan PIN 4 digit Ortu:</p>
        <input type="password" id="input-pin" maxlength="4" placeholder="****" class="w-full text-center tracking-widest text-lg font-bold py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-sky-400">
        <button onclick="verifyPin()" class="w-full bg-sky-500 hover:bg-sky-600 text-white font-bold py-2 rounded-xl text-xs transition">
          Masuk Dashboard
        </button>
      </div>

      <!-- DASHBOARD ORTU KONTEN -->
      <div id="ortu-content-section" class="hidden space-y-4">
        <!-- KONTROL BINTANG HARIAN -->
        <div class="bg-sky-50 p-3 rounded-2xl border border-sky-100">
          <p class="text-xs font-bold text-sky-800 mb-2">Atur Bintang Hari Ini:</p>
          <div class="flex items-center justify-between">
            <span id="ortu-stars-display" class="font-bold text-sm text-sky-700">5 / 5 ⭐</span>
            <div class="space-x-1">
              <button onclick="changeStars(-1)" class="bg-rose-500 text-white font-bold px-3 py-1 rounded-lg text-xs">-1 Bintang</button>
              <button onclick="changeStars(1)" class="bg-emerald-500 text-white font-bold px-3 py-1 rounded-lg text-xs">+1 Bintang</button>
            </div>
          </div>
        </div>

        <!-- KONFIRMASI BINTANG & BUKA CERITA -->
        <button onclick="confirmAndUnlockStory()" class="w-full bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold py-2.5 rounded-xl text-xs shadow-sm transition">
          🔓 Konfirmasi Misi & Buka Cerita Hari Ini
        </button>

        <!-- TAMBAH MISI CUSTOM -->
        <div class="border-t pt-3 space-y-2">
          <p class="text-xs font-bold text-slate-700">Berikan Misi Tambahan:</p>
          <input type="text" id="custom-quest-title" placeholder="Nama Misi (misal: Bantu Rapikan Meja)" class="w-full px-3 py-1.5 border text-xs rounded-xl">
          <div class="flex space-x-2">
            <select id="custom-quest-reward-type" class="text-xs border rounded-xl px-2 py-1">
              <option value="XP">+ XP</option>
              <option value="Star">+ Bintang</option>
            </select>
            <input type="number" id="custom-quest-reward-val" placeholder="Nilai (misal: 50)" class="w-full px-3 py-1.5 border text-xs rounded-xl">
          </div>
          <button onclick="addCustomQuest()" class="w-full bg-indigo-500 hover:bg-indigo-600 text-white font-bold py-2 rounded-xl text-xs transition">
            + Tambahkan Misi
          </button>
        </div>

        <p class="text-[10px] text-slate-400 text-center italic pt-2">
          URL GAS Terintegrasi Otomatis dari Berkas.
        </p>
      </div>
    </div>
  </div>

  <!-- SCRIPT LOGIKA UTAMA -->
  <script>
    // DATA APPS STATE
    let state = {
      stars: 5,
      xp: 0,
      shieldActive: false,
      storyUnlocked: false,
      activeTab: 'quests',
      quests: [
        { id: 'a1', title: '1. Bangun baik & Minum Air', xp: 20, type: 'atomic', completed: false },
        { id: 'a2', title: '2. Ucapkan Password "Kapten Fathan Siap!"', xp: 20, type: 'atomic', completed: false },
        { id: 'a3', title: '3. Olahraga Pagi (Peregangan Ksatria)', xp: 25, type: 'atomic', completed: false },
        { id: 'a4', title: '4. Membaca Al-Qur\'an', xp: 30, type: 'atomic', completed: false },
        { id: 'a5', title: '5. Membaca Buku', xp: 20, type: 'atomic', completed: false },
        { id: 'c1', title: 'Bertanya atau Menjawab di Kelas', xp: 50, type: 'courage', completed: false },
        { id: 'c2', title: 'Mendapat Teman Baru', xp: 100, type: 'courage', completed: false }
      ],
      rewards: [
        { id: 'r1', title: 'Voucher Bakso / Kebab Spesial', desc: 'Maksimal Rp 15.000', cost: 1000 },
        { id: 'r2', title: 'Voucher Extra Nonton & Game 30 Menit', desc: 'Di hari apa saja. Harus baik setelah bermain!', cost: 1500 },
        { id: 'r3', title: 'Voucher Jajan Minimarket', desc: 'Maksimal Rp 20.000', cost: 2000 }
      ]
    };

    // INIT
    window.onload = function() {
      renderHeader();
      renderQuests();
      renderRewards();
    };

    function renderHeader() {
      document.getElementById('header-stars').innerText = `${state.stars}/5`;
      document.getElementById('header-xp').innerText = `${state.xp} XP`;
    }

    function switchTab(tabName) {
      state.activeTab = tabName;
      document.getElementById('tab-content-quests').classList.add('hidden');
      document.getElementById('tab-content-rewards').classList.add('hidden');
      document.getElementById('tab-content-story').classList.add('hidden');

      document.getElementById('tab-btn-quests').className = "flex-1 py-2 rounded-xl text-xs font-bold transition text-slate-500";
      document.getElementById('tab-btn-rewards').className = "flex-1 py-2 rounded-xl text-xs font-bold transition text-slate-500";
      document.getElementById('tab-btn-story').className = "flex-1 py-2 rounded-xl text-xs font-bold transition text-slate-500";

      document.getElementById(`tab-content-${tabName}`).classList.remove('hidden');
      document.getElementById(`tab-btn-${tabName}`).className = "flex-1 py-2 rounded-xl text-xs font-bold transition bg-white text-sky-600 shadow-sm";
    }

    function activateShield() {
      state.shieldActive = true;
      document.getElementById('shield-placeholder').classList.add('hidden');
      document.getElementById('shield-content').classList.remove('hidden');
      document.getElementById('btn-activate-shield').innerText = "✓ Aktif";
      document.getElementById('btn-activate-shield').className = "bg-emerald-400 text-emerald-950 font-bold px-4 py-1.5 rounded-full text-xs cursor-default";
      
      sendDataToGAS({ action: 'log_activity', questTitle: 'Mengaktifkan Perisai Keberanian', rewardType: 'XP', rewardValue: 0 });
    }

    function renderQuests() {
      const atomicContainer = document.getElementById('container-atomic-quests');
      const courageContainer = document.getElementById('container-courage-quests');

      atomicContainer.innerHTML = '';
      courageContainer.innerHTML = '';

      state.quests.forEach(q => {
        const item = document.createElement('div');
        item.className = "flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100";
        item.innerHTML = `
          <div>
            <p class="text-xs font-semibold text-slate-800">${q.title}</p>
            <span class="text-[10px] font-bold text-sky-500">+${q.xp} XP</span>
          </div>
          <button onclick="completeQuest('${q.id}')" ${q.completed ? 'disabled' : ''} class="${q.completed ? 'bg-emerald-100 text-emerald-600' : 'bg-sky-400 hover:bg-sky-500 text-white'} font-bold px-3 py-1.5 rounded-xl text-xs shadow-sm transition">
            ${q.completed ? '✓ Selesai' : 'Selesai'}
          </button>
        `;

        if (q.type === 'atomic') atomicContainer.appendChild(item);
        else courageContainer.appendChild(item);
      });
    }

    function completeQuest(id) {
      const q = state.quests.find(x => x.id === id);
      if (q && !q.completed) {
        q.completed = true;
        state.xp += q.xp;
        renderHeader();
        renderQuests();

        sendDataToGAS({
          action: 'log_activity',
          questId: q.id,
          questTitle: q.title,
          category: q.type,
          rewardValue: q.xp
        });
      }
    }

    function renderRewards() {
      const container = document.getElementById('container-rewards-list');
      container.innerHTML = '';

      state.rewards.forEach(r => {
        const card = document.createElement('div');
        card.className = "p-3.5 bg-amber-50/60 border border-amber-200/60 rounded-2xl flex items-center justify-between";
        card.innerHTML = `
          <div>
            <p class="text-xs font-bold text-amber-900">${r.title}</p>
            <p class="text-[10px] text-amber-700">${r.desc}</p>
            <span class="text-[10px] font-bold text-amber-600 mt-1 inline-block">${r.cost} XP</span>
          </div>
          <button onclick="claimReward('${r.id}')" class="bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold px-3 py-1.5 rounded-xl text-xs shadow-sm transition">
            Tukar XP
          </button>
        `;
        container.appendChild(card);
      });
    }

    function claimReward(id) {
      const r = state.rewards.find(x => x.id === id);
      if (r) {
        if (state.xp >= r.cost) {
          state.xp -= r.cost;
          renderHeader();
          alert(`Berhasil menukarkan: ${r.title}! Tunjukkan ke Ortu ya!`);

          sendDataToGAS({
            action: 'claim_reward',
            rewardTitle: r.title,
            xpCost: r.cost,
            remainingXp: state.xp
          });
        } else {
          alert(`XP kamu belum cukup (${state.xp}/${r.cost} XP). Kumpulkan dari misi keberanian ya!`);
        }
      }
    }

    // MODAL & ORTU FUNCTIONS
    function toggleOrtuModal() {
      document.getElementById('modal-ortu').classList.toggle('hidden');
    }

    function verifyPin() {
      const pin = document.getElementById('input-pin').value;
      if (pin === '1234') {
        document.getElementById('ortu-auth-section').classList.add('hidden');
        document.getElementById('ortu-content-section').classList.remove('hidden');
      } else {
        alert('PIN Salah!');
      }
    }

    function changeStars(val) {
      state.stars = Math.max(0, Math.min(5, state.stars + val));
      document.getElementById('ortu-stars-display').innerText = `${state.stars} / 5 ⭐`;
      renderHeader();

      sendDataToGAS({
        action: 'update_stars',
        currentStars: state.stars,
        change: val
      });
    }

    function confirmAndUnlockStory() {
      state.storyUnlocked = true;
      document.getElementById('story-locked-notice').classList.add('hidden');
      document.getElementById('story-reader').classList.remove('hidden');

      document.getElementById('story-title').innerText = "Episode 1: Cahaya Redup di Balik Kaca Jendela";
      document.getElementById('story-text').innerHTML = `
        <p>Kapal Starlight mendarat di Planet Luminaria. Dari balik jendela, anak-anak Starling asyik bermain bola cahaya.</p>
        <p>Kapten Fathan rindu ikut bermain, namun dadanya berdebar ragu. Otto berkata: <em>"Kompas keberanian tidak akan menyala jika Kapten hanya menonton dari balik kaca!"</em></p>
        <p><strong>WUUUSSHH!</strong> Pintu kapal terbuka. Kapten Fathan memetik perisainya dan melangkah keluar!</p>
      `;

      alert('Cerita Hari Ini Berhasil Dibuka!');
      switchTab('story');
    }

    function addCustomQuest() {
      const title = document.getElementById('custom-quest-title').value;
      const rewardType = document.getElementById('custom-quest-reward-type').value;
      const val = parseInt(document.getElementById('custom-quest-reward-val').value) || 20;

      if (title) {
        state.quests.push({
          id: 'custom_' + Date.now(),
          title: `[Ortu] ${title}`,
          xp: val,
          type: 'courage',
          completed: false
        });
        renderQuests();
        alert('Misi Tambahan Berhasil Diberikan!');

        sendDataToGAS({
          action: 'custom_quest',
          title: title,
          rewardType: rewardType,
          rewardValue: val
        });
      }
    }

    // FUNGSI UTAMA PENGIRIMAN DATA KE GAS
    function sendDataToGAS(payload) {
      if (!DEFAULT_GAS_URL || DEFAULT_GAS_URL.includes("PASTE_WEB_APP_URL")) {
        console.warn("GAS_URL belum diisi pada berkas index.html!");
        return;
      }

      fetch(DEFAULT_GAS_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(() => console.log('Data terkirim ke GAS!'))
      .catch(err => console.error('Gagal mengirim data ke GAS:', err));
    }
  </script>
</body>
</html>
